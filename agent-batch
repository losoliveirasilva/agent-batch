def valid_title(title):
    return bool(title.strip()) and not any(ord(c) < 32 or ord(c) == 127 for c in title)


def render(template, values):
    # A single pass preserves literal {{markers}} in user-provided values.
    return PLACEHOLDER.sub(lambda match: values[match.group(1).upper()], template)


def read_template(cli, args):
    try:
        template = (Path(args.template).expanduser().read_text(encoding="utf-8")
                    if args.template is not None else args.prompt)
    except (OSError, UnicodeError, ValueError) as error:
        cli.error(str(error))
    if not template.strip():
        cli.error("the template cannot be empty")
    return template


def resolve_directory(path, base="."):
    # A relative path is resolved against base; ~ and absolute paths stand alone.
    if not path:
        raise ValueError("the directory cannot be empty")
    directory = (Path(base).expanduser() / Path(path).expanduser()).resolve(strict=True)
    if not directory.is_dir():
        raise NotADirectoryError(f"not a directory: {directory}")
    return str(directory)


def valid_directory(path, base):
    try:
        resolve_directory(path, base)
    except (OSError, ValueError):
        return False
    return True


def working_directory(cli, args):
    try:
        directory = resolve_directory(args.path)
    except (OSError, ValueError) as error:
        cli.error(str(error))
    if not valid_title(args.prefix):
        cli.error("--prefix must be a non-empty name without control characters")
    return directory


def parse_values(cli, assignments, context, duplicate_hint=""):
    values = {}
    for assignment in assignments:
        key, separator, value = assignment.partition("=")
        if not separator or not KEY.fullmatch(key):
            cli.error(f"{context}: expected KEY=VALUE, got {assignment!r}")
        key = key.upper()
        if key in values:
            cli.error(f"{context}: duplicate key {key}{duplicate_hint}")
        values[key] = value
    return values


def shared_values(cli, args):
    values = parse_values(cli, args.var or [], "--var")
    for key, option in BATCH_OPTIONS.items():
        if key in values:
            cli.error(f"--var: {key} cannot be shared; use {option}")
    return values


def prepare_item(cli, args, agents, template, shared, assignments, number):
    # Shared values fill keys the item does not set itself.
    values = shared | parse_values(cli, assignments, f"item {number}",
                                   "; use --item for another item")
    # AGENT selects the item's instance and is always available as {{AGENT}}.
    agent = values.setdefault("AGENT", args.agent)
    if agent not in agents:
        cli.error(f"item {number}: unknown instance {agent!r} in AGENT; "
                  f"available: {', '.join(agents)}")
    # PATH selects the item's directory; its value is also literal in {{PATH}}.
    try:
        directory = resolve_directory(values.get("PATH", "."), args.path)
    except (OSError, ValueError) as error:
        cli.error(f"item {number}: invalid PATH: {error}")
    # Item values are literal; the name templates apply only when they are absent.
    patterns = {key: pattern for key, pattern in (("TITLE", args.title),
                                                   ("SESSION_NAME", args.session_name))
                if pattern is not None and key not in values}
    missing = sorted({match.group(1).upper()
                      for text in (template, *patterns.values())
                      for match in PLACEHOLDER.finditer(text)} - values.keys())
    if missing:
        cli.error(f"item {number}: missing keys {', '.join(missing)}")
    prompt = render(template, values)
    names = values | {key: render(pattern, values) for key, pattern in patterns.items()}
    title = names.get("TITLE", f"{args.prefix}-{number}")
    session_name = names.get("SESSION_NAME")
    if not valid_title(title):
        cli.error(f"item {number}: the title (TITLE or --title) must be non-empty, "
                  "without control characters")
    if session_name is not None and not valid_title(session_name):
        cli.error(f"item {number}: the session name (SESSION_NAME or --session-name) "
                  "must be non-empty, without control characters")
    if "\0" in prompt:
        cli.error(f"item {number}: the prompt cannot contain NUL bytes")
    return title, agent, session_name, prompt, directory


def value_items(cli, args, template, shared):
    # --items fills the only key left without a value, so it never guesses.
    keys = [key for key in placeholder_keys(template, args, {}) if key not in shared]
    if not keys:
        cli.error("--items: the prompt, --title, and --session-name have no key without "
                  "a --var value for the values to fill")
    if len(keys) > 1:
        cli.error(f"--items fills only one key, but {len(keys)} keys have no --var value: "
                  f"{', '.join(keys)}; set all but one with --var, or use --item KEY=VALUE")
    key = keys[0]
    for value in args.items:
        # --item and --items are one letter apart; catch KEY=VALUE given to --items.
        if value.upper().startswith(f"{key}="):
            cli.error(f"--items takes bare values for {key}, got {value!r}; "
                      "for KEY=VALUE, use --item")
    return [[f"{key}={value}"] for value in args.items]


def prepare(cli, args, agents, template=None):
    if (args.prompt is None) == (args.template is None):
        cli.error("provide a prompt OR --template FILE")
    if template is None:
        template = read_template(cli, args)
    directory = working_directory(cli, args)
    shared = shared_values(cli, args)
    items = args.item or [[]]
    if args.items is not None:
        if args.item:
            cli.error("--items cannot be combined with --item")
        items = value_items(cli, args, template, shared)
    jobs = [prepare_item(cli, args, agents, template, shared, assignments, number)
            for number, assignments in enumerate(items, 1)]
    return directory, jobs


def check_backend(cli, args):
    if args.backend == "agent-manager":
        for option, value in (("--layout", args.layout), ("--pane-layout", args.pane_layout),
                              ("--session-name", args.session_name)):
            if value is not None:
                cli.error(f"{option} applies only to --backend tmux")
    args.layout = args.layout or "window"
    args.pane_layout = args.pane_layout or "even-horizontal"


def agent_command(agents, agent, prompt, session_name):
    spec = agents[agent]
    return AGENT_TYPES[spec["type"]](spec["command"], prompt, session_name)


def job_command(args, agents, job):
    title, agent, session_name, prompt, directory = job
    if args.backend == "agent-manager":
        return manager_command(agents, agent, title, prompt, session_name, directory)
    return agent_command(agents, agent, prompt, session_name)


def job_heading(number, job, default_agent, default_directory):
    title, agent, session_name, _, directory = job
    agent = f" · agent: {agent}" if agent != default_agent else ""
    session = f" · session: {session_name}" if session_name is not None else ""
    path = f" · path: {directory}" if directory != default_directory else ""
    return f"[{number}] {title}{agent}{session}{path}"


def enter_template():
    print("Paste the prompt. End with a line containing only a period (.):")
    lines = []
    while True:
        line = input()
        if line == ".":
            template = "\n".join(lines)
            if template.strip():
                return template
            print("The prompt cannot be empty. Try again:")
            lines = []
        else:
            lines.append(line)


def edit_template(cli, template):
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    try:
        command = shlex.split(editor)
    except ValueError as error:
        cli.error(f"invalid editor command: {error}")
    if not command or not shutil.which(command[0]):
        cli.error(f"editor not found: {editor}")
    descriptor, name = tempfile.mkstemp(prefix="agent-batch-prompt-", suffix=".txt")
    path = Path(name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(template)
        result = subprocess.run([*command, name])
        if result.returncode:
            cli.error(f"editor exited with status {result.returncode}")
        edited = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        cli.error(f"cannot edit prompt: {error}")
    finally:
        path.unlink(missing_ok=True)
    if not edited.strip():
        print("The prompt cannot be empty; the previous version was kept.")
        return template
    return edited


def choose_template(cli):
    history = load_history(cli)
    if not history:
        print("No prompts saved in history yet.")
        return enter_template()
    matches = history
    while True:
        print("\nSaved prompts:")
        for number, template in enumerate(matches[:12], 1):
            preview = " ".join(template.split())
            print(f"  {number}. {preview[:100]}{'…' if len(preview) > 100 else ''}")
        if len(matches) > 12:
            print(f"  ({len(matches) - 12} more; narrow your search)")
        choice = input("Number, /text to search, or n for a new prompt: ").strip()
        if choice.lower() == "n":
            return enter_template()
        if choice.startswith("/"):
            query = choice[1:].casefold()
            matches = [template for template in history if query in template.casefold()]
            if not matches:
                print("No matching prompts.")
            continue
        if choice.isdecimal() and 1 <= int(choice) <= min(len(matches), 12):
            return matches[int(choice) - 1]
        print("Choose a listed number, search, or enter n.")


def placeholder_keys(template, args, values):
    patterns = [template]
    if args.title is not None and "TITLE" not in values:
        patterns.append(args.title)
    if args.session_name is not None and "SESSION_NAME" not in values:
        patterns.append(args.session_name)
    keys = (match.group(1).upper()
            for pattern in patterns for match in PLACEHOLDER.finditer(pattern))
    # AGENT always has a value: the batch agent, or the item's "agent" choice.
    return list(dict.fromkeys(key for key in keys if key != "AGENT"))


def interactive_batch(cli, args, agents):
    if args.item or args.items:
        cli.error("--item and --items cannot be combined with interactive mode")
    if args.prompt is not None and args.template is not None:
        cli.error("provide a prompt OR --template FILE")
    directory = working_directory(cli, args)
    shared = shared_values(cli, args)
    if args.backend == "agent-manager":
        # Items default to the batch agent, so reject it before asking for them.
        try:
            manager_tool(agents[args.agent])
        except ValueError as error:
            cli.error(f"instance {args.agent}: {error}")
    print(f"Agent: {args.agent}\nPath: {directory}")
    if args.backend == "agent-manager":
        print("Backend: agent-manager")
    else:
        print(f"Layout: {args.layout}")
        if args.layout == "pane":
            print(f"Pane layout: {args.pane_layout}")
    if shared:
        print("Shared variables: " + ", ".join(f"{key}={value}"
                                               for key, value in shared.items()))
    print("To change these, press Ctrl-C and rerun with --agent, --path, --backend, "
          "--layout, or --var.")
    template = (read_template(cli, args) if args.prompt is not None or args.template is not None
                else choose_template(cli))
    jobs = []
    templates = []
    while True:
        number = len(jobs) + 1
        values = {}
        while True:
            print(f"\nItem {number}:")
            for key in placeholder_keys(template, args, values):
                if key not in values and key not in shared:
                    while True:
                        value = input(f"{key}: ")
                        if ("\0" in value
                                or (key in ("TITLE", "SESSION_NAME") and not valid_title(value))
                                or (key == "PATH" and not valid_directory(value, args.path))):
                            print(f"Invalid value for {key}.")
                            continue
                        values[key] = value
                        break
            assignments = [f"{key}={value}" for key, value in values.items()]
            job = prepare_item(cli, args, agents, template, shared, assignments, number)
            print(f"\n{job_heading(number, job, args.agent, directory)}\n{job[3]}")
            finish = "preview" if args.dry_run else "launch"
            action = input(f"[a]dd another item, [f]inish and {finish}, [e]dit prompt, "
                           "[t]itle, a[g]ent, [p]ath, [r]edo item, [c]ancel [f]: ").strip().lower()
            if action in ("", "f", "a"):
                jobs.append(job)
                templates.append(template)
                if action in ("", "f"):
                    return directory, jobs, templates
                break
            if action == "e":
                template = edit_template(cli, template)
            elif action == "t":
                while True:
                    title = input("Window/pane title (blank for batch default): ")
                    if not title:
                        if "TITLE" in placeholder_keys(template, args, {}):
                            print("TITLE is required by the prompt or name template.")
                            continue
                        values.pop("TITLE", None)
                        break
                    if not valid_title(title):
                        print("Invalid title; try again.")
                        continue
                    values["TITLE"] = title
                    break
            elif action == "g":
                print(f"Available agents: {', '.join(agents)}")
                while True:
                    agent = input(f"Agent for this item (blank for batch agent {args.agent}): ")
                    agent = agent.strip()
                    if not agent:
                        values.pop("AGENT", None)
                        break
                    if agent not in agents:
                        print("Unknown agent; try again.")
                        continue
                    try:
                        job_command(args, agents, (job[0], agent, *job[2:]))
                    except ValueError as error:
                        print(f"Agent {agent}: {error}")
                        continue
                    values["AGENT"] = agent
                    break
            elif action == "p":
                while True:
                    path = input(f"Directory for this item (blank for batch path {directory}): ")
                    if not path:
                        if "PATH" in placeholder_keys(template, args, {}):
                            print("PATH is required by the prompt or name template.")
                            continue
                        values.pop("PATH", None)
                        break
                    if not valid_directory(path, args.path):
                        print("Not a directory; try again.")
                        continue
                    values["PATH"] = path
                    break
            elif action == "r":
                values = {}
            elif action == "c":
                return None
            else:
                print("Invalid choice.")


def tmux(*args):
    result = subprocess.run(["tmux", *args], text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(f"tmux {args[0]}: {result.stderr.strip() or 'failed'}")
    return result.stdout.strip()


def launch(args, jobs):
    if not shutil.which("tmux"):
        raise RuntimeError("tmux not found in PATH")
    shell = os.environ.get("SHELL") or "/bin/bash"
    if Path(shell).name not in ("bash", "zsh", "sh", "dash", "ksh"):
        raise RuntimeError("set $SHELL to a POSIX-compatible shell (for example, zsh or bash)")
    inside = bool(os.environ.get("TMUX"))
    if not inside and not args.detach and not sys.stdin.isatty():
        raise RuntimeError("a terminal is required to attach to tmux; use --detach or --dry-run")

    session = None
    first_window = None
    panes = []
    # Keep new panes alive without loading the user's shell until the entire
    # layout is ready. Only these placeholder processes are respawned.
    try:
        if inside:
            target = ["-t", os.environ["TMUX_PANE"]] if os.environ.get("TMUX_PANE") else []
            session = tmux("display-message", "-p", *target, "#{session_id}")
        for index, (title, directory, _) in enumerate(jobs):
            window_name = args.prefix if args.layout == "pane" else title
            common = ["-d", "-P", "-F", "#{session_id} #{window_id} #{pane_id}", "-c", directory]
            if index == 0 and not inside:
                width, height = shutil.get_terminal_size((160, 48))
                identifiers = tmux("new-session", *common, "-x", str(width), "-y", str(height),
                                   "-n", window_name, "sleep", "2147483647")
            elif args.layout == "pane" and index:
                direction = "-v" if args.pane_layout == "even-vertical" else "-h"
                identifiers = tmux("split-window", *common, direction, "-t", panes[-1],
                                   "sleep", "2147483647")
            else:
                identifiers = tmux("new-window", *common, "-t", f"{session}:", "-n", window_name,
                                   "sleep", "2147483647")
            session, window, pane = identifiers.split()
            first_window = first_window or window
            panes.append(pane)
            tmux("set-option", "-w", "-t", window, "automatic-rename", "off")
            tmux("set-option", "-w", "-t", window, "allow-rename", "off")
            tmux("select-pane", "-t", pane, "-T", title)
            if args.layout == "pane":
                # Keep the label stable even if an agent changes its terminal title.
                tmux("set-option", "-p", "-t", pane, "@bulk_title", title)
                tmux("set-option", "-w", "-t", window, "pane-border-status", "top")
                tmux("set-option", "-w", "-t", window, "pane-border-format",
                     " #{pane_index}: #{@bulk_title} ")
                tmux("select-layout", "-t", window, args.pane_layout)
    except RuntimeError:
        if first_window:
            print(f"The batch was not started. Empty panes were kept in session {session}.",
                  file=sys.stderr)
        raise

    for pane, (_, directory, invocation) in zip(panes, jobs):
        # Interactive startup loads the user's shell functions and aliases.
        # Pass the prompt as one quoted argument, never as tmux keystrokes.
        command =(f"cd -- {shlex.quote(directory)} && {shlex.join(invocation)}; "
                   f"exec {shlex.quote(shell)} -i")
        tmux("respawn-pane", "-k", "-t", pane, "-c", directory, shell, "-ic", command)
    tmux("select-pane", "-t", panes[0])
    if args.detach:
        print(f"{len(jobs)} run(s) created. Session: {session}, window: {first_window}.")
        print(f"To attach: tmux attach-session -t {shlex.quote(session)}")
    elif inside:
        tmux("select-window", "-t", first_window)
    else:
        tmux("select-window", "-t", first_window)
        result = subprocess.run(["tmux", "attach-session", "-t", session])
        if result.returncode:
            raise RuntimeError(f"could not attach to session {session}; it is still available")


def spawn(jobs):
    if not shutil.which("agent-manager"):
        raise RuntimeError("agent-manager not found in PATH")
    for number, (title, command) in enumerate(jobs, 1):
        # agent-manager reports each created session, or why it failed.
        if subprocess.run(command).returncode:
            raise RuntimeError(f"agent-manager could not create item {number} ({title}); "
                               f"{number - 1} of {len(jobs)} run(s) were created")


def main():
    cli = parser()
    args = cli.parse_args()
    agents, default = load_agents(cli, args.config)
    if args.list_agents:
        for name, spec in agents.items():
            suffix = " (default)" if name == default else ""
            print(f"{name}{suffix}: type={spec['type']}, command={shlex.join(spec['command'])}")
        return 0
    args.agent = args.agent if args.agent is not None else default
    if args.agent not in agents:
        cli.error(f"unknown instance: {args.agent!r}; available: {', '.join(agents)}")
    spec = agents[args.agent]
    check_backend(cli, args)
    interactive = (args.interactive or (args.prompt is None and args.template is None
                                       and args.item is None and args.items is None
                                       and sys.stdin.isatty()))
    if interactive:
        if not sys.stdin.isatty():
            cli.error("interactive mode requires a terminal")
        try:
            batch = interactive_batch(cli, args, agents)
        except (EOFError, KeyboardInterrupt):
            print("\nCancelled.", file=sys.stderr)
            return 130
        if batch is None:
            print("Batch cancelled.")
            return 0
        directory, jobs, templates = batch
    else:
        template = read_template(cli, args) if args.prompt is not None or args.template is not None else None
        directory, jobs = prepare(cli, args, agents, template)
        templates = [template]
    invocations = []
    for number, job in enumerate(jobs, 1):
        try:
            invocations.append(job_command(args, agents, job))
        except ValueError as error:
            cli.error(f"item {number}: instance {job[1]}: {error}")
    if args.dry_run:
        target = (f"Layout: {args.layout}" if args.backend == "tmux"
                  else "Backend: agent-manager")
        print(f"Agent: {args.agent} (type: {spec['type']})\n"
              f"Base command: {shlex.join(spec['command'])}\n"
              f"Directory: {directory}\n{target}")
        for number, job in enumerate(jobs, 1):
            print(f"\n{job_heading(number, job, args.agent, directory)}\n{job[3]}")
        return 0
    save_history(cli, templates)
    try:
        if args.backend == "agent-manager":
            spawn([(title, invocation) for (title, *_), invocation in zip(jobs, invocations)])
        else:
            launch(args, [(title, job_directory, invocation)
                          for (title, *_, job_directory), invocation in zip(jobs, invocations)])
    except (OSError, RuntimeError) as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
